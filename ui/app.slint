import { VerticalBox, HorizontalBox, Button, TextEdit, StandardButton } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Vuzt with Slint + Egui";
    width: 400px;
    height: 600px;
    
    // State untuk input teks
    property <string> input_text: "";
    property <string> output_text: "";
    property <bool> show_egui: false;
    
    VerticalBox {
        padding: 20px;
        spacing: 15px;
        
        Text {
            text: "Vuzt Hybrid App";
            font-size: 24px;
            font-weight: 800;
            horizontal-alignment: center;
            color: #2196f3;
        }
        
        Text {
            text: "Slint UI + Egui Canvas";
            font-size: 14px;
            horizontal-alignment: center;
            color: #888888;
        }
        
        Rectangle {
            height: 1px;
            background: #333333;
            margin-top: 10px;
            margin-bottom: 10px;
        }
        
        Text {
            text: "Input Teks (Slint Native):";
            font-size: 14px;
            font-weight: 600;
        }
        
        TextEdit {
            text <=> input_text;
            placeholder-text: "Ketik sesuatu di sini...";
            height: 40px;
            border-radius: 8px;
            border-width: 1px;
            border-color: #444444;
            background: #2a2a2a;
            color: #ffffff;
        }
        
        Text {
            text: "Output: " + input_text;
            font-size: 14px;
            wrap: word-wrap;
            color: #4caf50;
        }
        
        Rectangle {
            height: 1px;
            background: #333333;
            margin-top: 10px;
            margin-bottom: 10px;
        }
        
        Text {
            text: "Egui Canvas (Rust Native):";
            font-size: 14px;
            font-weight: 600;
        }
        
        // Tombol untuk membuka Egui window
        Button {
            text: "Buka Egui Viewer";
            clicked => {
                show_egui = true;
            }
        }
        
        // Tombol untuk aksi lain
        HorizontalBox {
            spacing: 10px;
            Button {
                text: "Clear Input";
                clicked => {
                    input_text = "";
                }
            }
            Button {
                text: "Uppercase";
                clicked => {
                    input_text = input_text.to-uppercase();
                }
            }
            Button {
                text: "Lowercase";
                clicked => {
                    input_text = input_text.to-lowercase();
                }
            }
        }
        
        Rectangle {
            height: 1px;
            background: #333333;
            margin-top: 10px;
            margin-bottom: 10px;
        }
        
        Text {
            text: "Info:";
            font-size: 12px;
            color: #888888;
            wrap: word-wrap;
        }
        
        Text {
            text: "Aplikasi ini menggabungkan Slint (UI framework) dan Egui (immediate mode GUI). Slint untuk layout utama, Egui untuk canvas/graph custom.";
            font-size: 11px;
            color: #666666;
            wrap: word-wrap;
        }
    }
    
    // Popup window untuk Egui
    if show_egui : Dialog {
        title: "Egui Canvas Viewer";
        width: 500px;
        height: 400px;
        
        VerticalBox {
            EguiCanvas {
                width: 100%;
                height: 300px;
            }
            
            Button {
                text: "Tutup";
                clicked => {
                    show_egui = false;
                }
            }
        }
    }
}

// Custom widget untuk embed Egui
export component EguiCanvas {
    width: 100%;
    height: 100%;
    
    // Placeholder - akan di-render oleh Rust melalui egui
    Rectangle {
        background: #1e1e1e;
        border-radius: 8px;
        
        Text {
            text: "Egui Canvas Area";
            font-size: 16px;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: #888888;
        }
    }
}
