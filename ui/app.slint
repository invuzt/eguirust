import { VerticalBox, HorizontalBox, Button, TextEdit } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Vuzt with Slint";
    width: 400px;
    height: 500px;
    
    property <string> input_text: "";
    property <int> counter: 0;
    
    VerticalBox {
        padding: 20px;
        spacing: 15px;
        
        Text {
            text: "Vuzt Slint App";
            font-size: 24px;
            font-weight: 800;
            horizontal-alignment: center;
            color: #2196f3;
        }
        
        Text {
            text: "Native Slint UI on Android";
            font-size: 14px;
            horizontal-alignment: center;
            color: #888888;
        }
        
        Rectangle {
            height: 1px;
            background: #333333;
        }
        
        Text {
            text: "Input Text:";
            font-size: 14px;
        }
        
        TextEdit {
            text <=> input_text;
            placeholder-text: "Ketik sesuatu...";
            height: 40px;
        }
        
        Text {
            text: "You typed: " + input_text;
            font-size: 14px;
            color: #4caf50;
        }
        
        Rectangle {
            height: 1px;
            background: #333333;
        }
        
        HorizontalBox {
            spacing: 10px;
            Button {
                text: "Counter: " + counter;
                clicked => {
                    counter += 1;
                }
            }
            Button {
                text: "Reset";
                clicked => {
                    counter = 0;
                    input_text = "";
                }
            }
            Button {
                text: "Uppercase";
                clicked => {
                    input_text = input_text.to-uppercase();
                }
            }
        }
        
        Rectangle {
            height: 1px;
            background: #333333;
        }
        
        Text {
            text: "Info: Aplikasi Slint berjalan di Android!";
            font-size: 11px;
            color: #666;
            wrap: word-wrap;
        }
    }
}
